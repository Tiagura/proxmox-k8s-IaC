global_defs {
    enable_script_security
}

vrrp_script check_kubernetes_api {
    script "/usr/local/bin/check-kubernetes-api.sh"
    interval 2
    timeout 2
    fall 3
    rise 2
    weight -50
}

vrrp_instance VI_1 {
    state MASTER
    interface {{ keepalived_interface }}
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_pwd }}
    }
    track_script {
        check_kubernetes_api
    }
    virtual_ipaddress {
        {{ vip_address }}
    }
}
